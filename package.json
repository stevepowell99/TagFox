{
  "name": "tagbrowser",
  "version": "1.5.0",
  "description": "Whippet: a fast file finder for Windows, over Voidtools Everything",
  "license": "MIT",
  "author": "Stephen Powell",
  "repository": "github:stevepowell99/whippet-files",
  "main": "main.js",
  "scripts": {
    "build:help": "node scripts/build-help.js",
    "vendor:sync": "node scripts/sync-vendor-assets.js",
    "postinstall": "install-electron && node scripts/sync-vendor-assets.js",
    "prestart": "npm run vendor:sync && npm run build:help",
    "predist": "npm run vendor:sync && npm run build:help",
    "start": "node scripts/start.js",
    "dist": "node scripts/run-dist.js",
    "test": "node test/run-all.cjs",
    "test:smoke": "node test/smoke.cjs",
    "test:loadmore": "node test/loadmore-regression.cjs",
    "test:fuzz": "node test/fuzz.cjs"
  },
  "build": {
    "appId": "app.tagbrowser",
    "productName": "Whippet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "web-editor-toolbar.html",
      "web-editor-toolbar-preload.js",
      "preload.js",
      "index.html",
      "help.html",
      "styles.css",
      "tags.js",
      "preview-text-helpers.js",
      "file-dialog-handoff.js",
      "everything-setup.js",
      "did-you-know-tips.js",
      "renderer.js",
      "package.json",
      "google-oauth-client.json",
      "vendor/**/*",
      "icons/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "icons/whippet.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "bootstrap": "5.3.3",
    "codemirror": "5.65.20",
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^14.1.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "dependencies": {
    "@googleapis/drive": "^16.0.0",
    "@kenjiuno/msgreader": "^1.28.0",
    "google-auth-library": "^10.6.2",
    "koffi": "^3.3.4",
    "word-extractor": "^1.0.4"
  }
}
