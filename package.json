{
  "name": "tagbrowser",
  "version": "1.1.2",
  "description": "TagFox — local Everything search UI (Electron)",
  "main": "main.js",
  "scripts": {
    "build:help": "node scripts/build-help.js",
    "vendor:sync": "node scripts/sync-vendor-assets.js",
    "postinstall": "node scripts/sync-vendor-assets.js",
    "prestart": "npm run vendor:sync && npm run build:help",
    "predist": "npm run vendor:sync && npm run build:help",
    "start": "electron .",
    "dist": "node scripts/run-dist.js",
    "test": "node test/run-all.cjs",
    "test:smoke": "node test/smoke.cjs",
    "test:tabs": "node test/tab-lifecycle.cjs",
    "test:loadmore": "node test/loadmore-regression.cjs",
    "test:fuzz": "node test/fuzz.cjs"
  },
  "build": {
    "appId": "app.tagbrowser",
    "productName": "TagFox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "google-workspace-toolbar.html",
      "google-workspace-toolbar-preload.js",
      "preload.js",
      "index.html",
      "help.html",
      "styles.css",
      "tags.js",
      "preview-text-helpers.js",
      "did-you-know-tips.js",
      "renderer.js",
      "package.json",
      "google-oauth-client.json",
      "vendor/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "bootstrap": "5.3.3",
    "codemirror": "5.65.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^14.1.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@googleapis/drive": "^16.0.0",
    "@kenjiuno/msgreader": "^1.28.0",
    "google-auth-library": "^10.6.2"
  }
}
