{
  "name": "tagbrowser",
  "version": "1.0.0",
  "description": "TagFox — local Everything search UI (Electron)",
  "main": "main.js",
  "scripts": {
    "build:help": "node scripts/build-help.js",
    "prestart": "npm run build:help",
    "predist": "npm run build:help",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "app.tagbrowser",
    "productName": "TagFox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "google-workspace-toolbar.html",
      "google-workspace-toolbar-preload.js",
      "preload.js",
      "index.html",
      "help.html",
      "styles.css",
      "tags.js",
      "renderer.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "marked": "^14.1.3"
  }
}
